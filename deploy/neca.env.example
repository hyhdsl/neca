# neca CLI 容器环境变量模板（复制到服务器 /opt/ipsec/neca.env，chmod 600）。
# 不要把真实值提交到仓库。

PKI_DIR=/opt/ipsec/pki
CA_CERT=/opt/ipsec/pki/ca.crt
CA_KEY=/opt/ipsec/pki/ca.key
CADB_DIR=/opt/ipsec/pki/ca
INDEX_FILE=/opt/ipsec/pki/ca/index.txt
CRLNUM_FILE=/opt/ipsec/pki/ca/crlnumber
CA_CONF=/opt/ipsec/pki/ca/openssl.cnf
CRL_DIR=/opt/ipsec/swanctl/x509crl
CRL_FILE=/opt/ipsec/swanctl/x509crl/ca.crl.pem
CLIENTS_DIR=/opt/ipsec/clients
META_DIR=/opt/ipsec/pki/meta
ARCHIVE_DIR=/opt/ipsec/pki/archive
EXPORT_DIR=/opt/ipsec/exports
NECA_DOWNLOAD_DIR=/opt/ipsec/downloads
NECA_AUDIT_LOG=/opt/ipsec/pki/audit.log

CONTAINER=ipsec-vpn
DOCKER_BIN=docker
NECA_RELOAD_MODE=creds
SERVER_ID=vpn.example.com
ORG=ExampleOrg
CA_CN=ExampleOrg VPN CA
DEFAULT_DAYS=365
KEY_BITS=3072
NECA_P12_PROFILE=compat
NECA_INSTALLERS=none
NECA_DOWNLOAD_TTL=30m
NECA_DOWNLOAD_MAX_FILES=50
