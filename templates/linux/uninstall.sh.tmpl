#!/usr/bin/env bash
# Example VPN - Linux IKEv2 uninstaller for strongSwan.
# Run as root. Supports NECA_ROOT (test sandbox) and NECA_DRY_RUN=1.
set -e

CN="{{.CN}}"
ROOT="$NECA_ROOT"
DRY_RUN="$NECA_DRY_RUN"
DEST="$ROOT/etc/swanctl"
TRUST_DIR="$ROOT/usr/local/share/ca-certificates"
CONF="$DEST/conf.d/neca-$CN.conf"

say() { printf '[INFO] %s
' "$*"; }
ok() { printf '[OK]   %s
' "$*"; }
run() { if [ "$DRY_RUN" = "1" ]; then printf '[DRY-RUN] %s
' "$*"; else "$@"; fi; }

if [ "$(id -u)" -ne 0 ] && [ -z "$ROOT" ]; then
  echo '[ERR]  run as root, or set NECA_ROOT for a test sandbox' >&2
  exit 1
fi

say "Removing Example VPN client $CN"
run rm -f "$CONF" "$DEST/x509ca/neca-$CN-ca.crt" "$DEST/x509/neca-$CN.crt" "$DEST/private/neca-$CN.key"

if [ -z "$ROOT" ]; then
  run rm -f "$TRUST_DIR/neca-$CN-ca.crt"
  if command -v update-ca-certificates >/dev/null 2>&1; then
    run update-ca-certificates
  elif command -v update-ca-trust >/dev/null 2>&1; then
    run update-ca-trust
  fi
  if command -v swanctl >/dev/null 2>&1; then
    run swanctl --load-all
  elif command -v systemctl >/dev/null 2>&1; then
    run systemctl restart strongswan
  fi
else
  say "Test sandbox: skipped system CA store and strongSwan reload"
fi

ok "Removed $CN"
