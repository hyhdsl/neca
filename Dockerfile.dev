# syntax=docker/dockerfile:1
#
# neca 开发/测试镜像（开发文档 §14.1 / 决策 D7）。
#
# 本机没有 Go，也没有可用的 WSL 发行版，所以全部 build / vet / test / 交叉编译
# 都在这个容器里完成，保证与服务器同属 Debian 家族（bookworm），
# 避免"本机能跑、服务器不能跑"的环境漂移。
FROM golang:1.25-bookworm

# 容器内需要的外部工具：
#   openssl         —— 证书签发/吊销/CRL 全部通过 openssl 子进程完成（决策 D4）
#   git             —— 构建时读取版本号与提交哈希，供 -ldflags 注入
#   make            —— Makefile 是唯一构建入口（文档 §14.2）
#   ca-certificates —— 访问 Go module 代理 / GitHub 时的根证书
#   gcc + libc6-dev —— go test -race 在 linux/amd64 上需要 cgo 编译器
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      ca-certificates \
      git \
      make \
      openssl \
      gcc \
      libc6-dev \
 && rm -rf /var/lib/apt/lists/*

# 开发容器默认开启 cgo，才能执行 go test -race；
# 发布构建由 Makefile 显式覆盖为 CGO_ENABLED=0，产出静态二进制。
ENV CGO_ENABLED=1

WORKDIR /src

# 故意不 COPY 源码：开发时用 bind mount 挂载仓库，
# 容器里的 go build/test 直接作用于宿主机工作区，改完即测。
CMD ["bash"]
