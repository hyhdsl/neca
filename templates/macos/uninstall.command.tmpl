#!/bin/bash
# Example VPN - macOS IKEv2 uninstaller.
# Double-click or run with sudo. Set NECA_DRY_RUN=1 to preview.
set -e

CN="{{.CN}}"
CA_CN="{{.CA}}"
PROFILE_ID="{{.ProfileID}}"
KEYCHAIN="$NECA_KEYCHAIN"
[ -n "$KEYCHAIN" ] || KEYCHAIN="/Library/Keychains/System.keychain"
DRY_RUN="$NECA_DRY_RUN"

say() { printf '[INFO] %s
' "$*"; }
ok() { printf '[OK]   %s
' "$*"; }
run() { if [ "$DRY_RUN" = "1" ]; then printf '[DRY-RUN] %s
' "$*"; else "$@"; fi; }

if [ "$(id -u)" -ne 0 ] && [ "$DRY_RUN" != "1" ]; then
  exec sudo "$0" "$@"
fi

say "Removing Example VPN client $CN"
if [ "$DRY_RUN" = "1" ]; then
  printf '[DRY-RUN] security delete-certificate -c %s %s
' "$CN" "$KEYCHAIN"
  printf '[DRY-RUN] security delete-certificate -c %s %s
' "$CA_CN" "$KEYCHAIN"
  printf '[DRY-RUN] profiles remove -identifier %s
' "$PROFILE_ID"
else
  security delete-certificate -c "$CN" "$KEYCHAIN" 2>/dev/null || true
  security delete-certificate -c "$CA_CN" "$KEYCHAIN" 2>/dev/null || true
  if command -v profiles >/dev/null 2>&1; then
    profiles remove -identifier "$PROFILE_ID" 2>/dev/null || true
  fi
fi
ok "Removed $CN"
